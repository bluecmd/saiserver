common --lockfile_mode=error
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --incompatible_strict_action_env
build --action_env=PATH=/nonexistent
build --action_env=LC_ALL=C
build --action_env=TZ=UTC
# rules_rust's two process-wrapper bootstrap actions and three placeholder
# copies require Bash/cp. Full hermetic mode pins these in bazelw's OCI image.
build --host_action_env=PATH=/usr/bin:/bin
build --host_action_env=LC_ALL=C
build --host_action_env=TZ=UTC
build --stamp=0
build --spawn_strategy=sandboxed
build --sandbox_default_allow_network=false
# Rust's prebuilt standard library requests -lgcc_s; use the hermetic shim.
build --@toolchains_llvm_bootstrapped//config:experimental_stub_libgcc_s=True
# Bazel's own Unix test-setup.sh / XML harness requires bootstrap shell tools;
# target compilation/codegen retain PATH=/nonexistent; execution bootstrap
# tools use the separate fixed host_action_env above.
test --test_env=PATH=/usr/bin:/bin
test --test_env=USER=builder
test --test_output=errors
