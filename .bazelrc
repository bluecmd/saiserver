common --lockfile_mode=error
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --incompatible_strict_action_env
build --action_env=PATH=/nonexistent
build --action_env=LC_ALL=C
build --action_env=TZ=UTC
# rules_rust's two process-wrapper bootstrap actions and three placeholder
# copies require Bash/cp. --config=remote runs them in a digest-pinned image.
build --host_action_env=PATH=/usr/bin:/bin
build --host_action_env=LC_ALL=C
build --host_action_env=TZ=UTC
build --stamp=0
build --spawn_strategy=sandboxed
build --sandbox_default_allow_network=false
# Rust's prebuilt standard library requests -lgcc_s; use the hermetic shim.
build --@toolchains_llvm_bootstrapped//config:experimental_stub_libgcc_s=True
# Bazel's own Unix test-setup.sh / XML harness requires host shell tools;
# target compilation/codegen retain PATH=/nonexistent; execution bootstrap
# tools use the separate fixed host_action_env above.
test --test_env=PATH=/usr/bin:/bin
test --test_env=USER=builder
test --test_output=errors

# Sanitized builds/tests with the toolchain's own runtimes. Use one at a time:
# enabling both makes the toolchain's runtime selection ambiguous.
build:asan --@toolchains_llvm_bootstrapped//config:asan
build:ubsan --@toolchains_llvm_bootstrapped//config:ubsan

# Rust lints, failing on any warning: bazel build --config=clippy //...
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
build:clippy --@rules_rust//rust/settings:clippy_flags=-Dwarnings

# Remote execution on BuildBuddy (argocd-apps/apps/buildbuddy), with its cache
# and build-event UI: actions run in the digest-pinned Debian container of
# //platforms:remote_linux_x86_64. Tests that need local kernel features
# (tagged no-remote-exec) still run in the local sandbox.
#   bazel test --config=remote //...
build:remote --remote_executor=grpc://100.99.0.75:1985
build:remote --remote_cache=grpc://100.99.0.75:1985
build:remote --bes_backend=grpc://100.99.0.75:1985
build:remote --bes_results_url=https://buildbuddy.k8s.mainframe.dev/invocation/
build:remote --remote_timeout=10m
build:remote --remote_cache_compression
build:remote --extra_execution_platforms=//platforms:remote_linux_x86_64
build:remote --spawn_strategy=remote,sandboxed
build:remote --jobs=50
