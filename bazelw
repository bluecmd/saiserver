#!/usr/bin/env bash
# Only the OCI engine and this launcher run on the host. Build tools run inside
# the digest-pinned image; no host toolchain, environment, or home is forwarded.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./bazelw [--cwd REPO_SUBDIR] [--] COMMAND [BAZEL_ARGUMENTS...]

Examples:
  ./bazelw build //...
  ./bazelw test //:tests
  ./bazelw --cwd examples/bazel build //...
  ./bazelw help

--cwd defaults to the repository root; relative paths are relative to that root.
Only Bazel command options (not startup options) follow COMMAND.

Environment (launcher configuration only; never forwarded into the container):
  BAZELW_CONTAINER_ENGINE  Engine executable; defaults to podman, then docker.
  BAZELW_CACHE_DIR         Dedicated writable cache outside the checkout;
                          defaults to $HOME/.cache/saiserver-bazel-bootstrap.

The image is built from an EMPTY context on each invocation (layers are cached)
and run by the resulting immutable image ID, never a tag. The entire checkout
is read-only, .lab is hidden, and the container runs as your non-root UID/GID.
HOME, downloads, outputs, and Bazel convenience symlinks live in the cache.
Repository downloads use container networking, never host networking; build
and test actions have networking disabled. Build/test/run require linux-sandbox
without fallback. The engine needs support for nested unprivileged user/mount
namespaces; seccomp and proc/sys path masking are relaxed for this purpose.
The container still has its own PID namespace, a read-only root, and no added
capabilities, privileged mode, devices, engine socket, host home, or SDK mounts.
EOF
}

die() { printf 'bazelw: %s\n' "$*" >&2; exit 1; }
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
workdir=$repo
while (($#)); do
    case $1 in
        --help|-h) usage; exit 0 ;;
        --cwd)
            (($# >= 2)) || die '--cwd requires a directory'
            case $2 in
                /*) workdir=$2 ;;
                *) workdir=$repo/$2 ;;
            esac
            shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
(($#)) || { usage; exit 2; }
command_name=$1
shift
[[ $command_name != -* ]] || die 'expected a Bazel command, not a startup option'
# A mnemonic/regexp/test-specific strategy has precedence over spawn_strategy.
# Do not let command options silently defeat the sandbox/network requirement.
# Arguments after '--' belong to the program, not Bazel's execution policy.
case $command_name in
    build|test|run|coverage|aquery|cquery)
        for arg in "$@"; do
            [[ $arg != -- ]] || break
            case $arg in
                --strategy*|--spawn_strategy*|--test_strategy*|--spawn_scheduler*|--experimental_spawn_scheduler*)
                    die 'execution-strategy overrides are not allowed; linux-sandbox is mandatory' ;;
            esac
        done ;;
esac
workdir=$(cd -- "$workdir" && pwd -P) || die 'invalid command working directory'
case $workdir/ in "$repo/"*) ;; *) die '--cwd must be inside this checkout' ;; esac
case $workdir/ in "$repo/.lab/"*) die '.lab is not available in the bootstrap container' ;; esac
container_cwd=/workspace${workdir#"$repo"}

uid=$(id -u)
gid=$(id -g)
[[ $uid != 0 ]] || die 'run as a non-root user (not sudo)'
engine=${BAZELW_CONTAINER_ENGINE:-}
if [[ -z $engine ]]; then
    if command -v podman >/dev/null 2>&1; then engine=podman
    elif command -v docker >/dev/null 2>&1; then engine=docker
    else die 'install Podman or Docker, or set BAZELW_CONTAINER_ENGINE'; fi
fi
command -v "$engine" >/dev/null 2>&1 || die "container engine not found: $engine"
case $("$engine" --version) in
    *[Pp]odman*) engine_kind=podman ;;
    *[Dd]ocker*) engine_kind=docker ;;
    *) die 'BAZELW_CONTAINER_ENGINE must be a Podman or Docker executable' ;;
esac
cache=${BAZELW_CACHE_DIR:-${HOME:?HOME must be set}/.cache/saiserver-bazel-bootstrap}
# Resolve symlinks BEFORE creating anything: never initialize a cache in source.
cache=$(realpath -m -- "$cache")
[[ $cache != / ]] || die 'BAZELW_CACHE_DIR must be a dedicated directory, not /'
home=$(realpath -m -- "${HOME:?HOME must be set}")
case $home/ in "$cache/"*) die 'BAZELW_CACHE_DIR must not contain the host home directory' ;; esac
case $cache/ in "$repo/"*) die 'BAZELW_CACHE_DIR must be outside the checkout' ;; esac
# Ancestors of source would expose a writable copy of source via /cache as well.
case $repo/ in "$cache/"*) die 'BAZELW_CACHE_DIR must not contain the checkout' ;; esac
[[ $cache != *:* && $repo != *:* && $cache != *,* && $repo != *,* ]] || die 'mount paths must not contain colons or commas'
mkdir -p -- "$cache/home" "$cache/output" "$cache/repository-cache" "$cache/symlinks"
[[ -O $cache && -w $cache ]] || die 'cache must be owned by and writable by the current user'
build_tmp=$(mktemp -d "$cache/.image-build.XXXXXXXX")
trap 'rm -rf -- "$build_tmp"' EXIT
mkdir -- "$build_tmp/context"
# An empty context guarantees that .lab, .git, local credentials, and SDKs are
# never sent to the builder. No .dockerignore or host source COPY is necessary.
build_options=(--platform=linux/amd64 --network=none)
case $engine_kind in
    podman) build_options+=(--http-proxy=false) ;;
    # Docker otherwise exposes predefined proxy build args from client config.
    docker) build_options+=(--build-arg HTTP_PROXY= --build-arg HTTPS_PROXY=
        --build-arg FTP_PROXY= --build-arg ALL_PROXY= --build-arg NO_PROXY=
        --build-arg http_proxy= --build-arg https_proxy= --build-arg ftp_proxy=
        --build-arg all_proxy= --build-arg no_proxy=) ;;
esac
"$engine" build "${build_options[@]}" \
    --file - --iidfile "$build_tmp/image-id" "$build_tmp/context" \
    < "$repo/bazel/bootstrap.Dockerfile" >&2
image_id=$(<"$build_tmp/image-id")
[[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]] || die 'engine did not return a full immutable image ID'
printf 'bazelw: running %s (%s)\n' "$image_id" "$engine" >&2

runtime=(run --rm --interactive --platform=linux/amd64 --pull=never
    --user "$uid:$gid" --read-only --cap-drop=ALL
    --security-opt=no-new-privileges --security-opt=seccomp=unconfined
    --env HOME=/cache/home --env PATH=/usr/local/bin:/usr/bin:/bin
    --env LANG=C.UTF-8 --env LC_ALL=C.UTF-8 --env TZ=UTC
    --volume "$repo:/workspace:ro" --volume "$cache:/cache:rw"
    --tmpfs /tmp:rw,nosuid,nodev,mode=1777 --workdir "$container_cwd")
# Podman rootless maps the invoking UID/GID to the same numbers in the container.
# Disable SELinux relabeling rather than mutating the read-only source tree.
# Nested linux-sandbox must mount its own proc/sys. Kernel mount restrictions
# prohibit that if the outer container masks paths on the inherited proc/sys.
# Relax those masks, NOT the capability bounding set or PID namespace isolation.
case $engine_kind in
    podman) runtime+=(--userns=keep-id --network=private --security-opt=label=disable
        --security-opt=unmask=ALL --http-proxy=false) ;;
    # Docker can also inject client-configured proxies at run time. Explicit
    # empty values prevent those host credentials from reaching the container.
    docker) runtime+=(--network=bridge --security-opt=label=disable --security-opt=systempaths=unconfined
        --env HTTP_PROXY= --env HTTPS_PROXY= --env FTP_PROXY= --env ALL_PROXY=
        --env NO_PROXY= --env http_proxy= --env https_proxy= --env ftp_proxy=
        --env all_proxy= --env no_proxy=) ;;
esac
# Preserve terminal semantics only for an interactive "run". TERM is runtime
# input; strict action environments do not inherit it during compilation.
if [[ $command_name == run && -t 0 && -t 1 ]]; then
    runtime+=(--tty --env "TERM=${TERM:-xterm-256color}")
fi
if [[ -e $repo/.lab ]]; then
    # Podman otherwise copies the underlying directory into its tmpfs, which
    # would defeat the SDK mask. Docker tmpfs mounts do not copy up by default.
    if [[ $engine_kind == podman ]]; then
        runtime+=(--tmpfs /workspace/.lab:ro,nosuid,nodev,noexec,notmpcopyup)
    else
        runtime+=(--tmpfs /workspace/.lab:ro,nosuid,nodev,noexec)
    fi
fi

bazel_args=(--batch --nosystem_rc --nohome_rc --output_user_root=/cache/output
    "$command_name" "$@")
# Append mandatory options AFTER user arguments. If there is a '--' separator
# (e.g. bazel run //tool -- args), put them before it, not in the program's argv.
# These commands inherit build options; other commands (help/query/etc.) do not.
case $command_name in
    build|test|run|coverage|aquery|cquery)
        enforced=(--repository_cache=/cache/repository-cache
            --lockfile_mode=error --symlink_prefix=/cache/symlinks/bazel-
            --spawn_strategy=linux-sandbox '--strategy_regexp=.*=linux-sandbox'
            --sandbox_default_allow_network=false)
        before=() after=() separated=false
        for arg in "$@"; do
            if [[ $separated == true ]]; then after+=("$arg")
            elif [[ $arg == -- ]]; then separated=true
            else before+=("$arg"); fi
        done
        bazel_args=(--batch --nosystem_rc --nohome_rc --output_user_root=/cache/output
            "$command_name" "${before[@]}" "${enforced[@]}")
        if [[ $separated == true ]]; then bazel_args+=(-- "${after[@]}"); fi
        ;;
    # Repository cache and lock policy apply to commands that can fetch as well.
    fetch|query|mod|sync|info)
        bazel_args+=(--repository_cache=/cache/repository-cache --lockfile_mode=error)
        ;;
esac
# Do not use exec: the EXIT trap must remove our tiny temporary build context.
"$engine" "${runtime[@]}" "$image_id" "${bazel_args[@]}"
