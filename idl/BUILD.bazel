load("//bazel:constraints.bzl", "LINUX_X86_64")
load("//bazel:thrift.bzl", "cc_thrift_library", "rust_thrift_library", "thrift_codegen", "thrift_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "sai_tui.thrift",
    "switch_sai.thrift",
])

thrift_library(
    name = "sai_tui_thrift",
    src = "sai_tui.thrift",
)

# The legacy service, which inherits the bounded SaiTui service.
thrift_library(
    name = "switch_sai_thrift",
    src = "switch_sai.thrift",
    deps = [":sai_tui_thrift"],
)

cc_thrift_library(
    name = "switch_sai_cc",
    outs = [
        "SaiTui.cpp",
        "SaiTui.h",
        "sai_tui_types.cpp",
        "sai_tui_types.h",
        "switch_sai_rpc.cpp",
        "switch_sai_rpc.h",
        "switch_sai_types.cpp",
        "switch_sai_types.h",
    ],
    lib = ":switch_sai_thrift",
    recursive = True,
)

# Standalone RPC crate, without the TUI's Ratatui dependency tree.
rust_thrift_library(
    name = "sai_tui_rust",
    out = "sai_tui.rs",
    crate_name = "sai_tui_rpc",
    lib = ":sai_tui_thrift",
    target_compatible_with = LINUX_X86_64,
)

# Python modules for ./saiclient, which also needs the `thrift` pip package.
thrift_codegen(
    name = "switch_sai_py",
    outs = ["_thrift_gen/switch_sai_py/" + f for f in [
        "__init__.py",
        "sai_tui/SaiTui-remote",
        "sai_tui/SaiTui.py",
        "sai_tui/__init__.py",
        "sai_tui/constants.py",
        "sai_tui/ttypes.py",
        "switch_sai/__init__.py",
        "switch_sai/constants.py",
        "switch_sai/switch_sai_rpc-remote",
        "switch_sai/switch_sai_rpc.py",
        "switch_sai/ttypes.py",
    ]],
    language = "py",
    lib = ":switch_sai_thrift",
    recursive = True,
)
