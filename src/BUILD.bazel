load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:constraints.bzl", "LINUX")
load("//bazel:copts.bzl", "SAISERVER_COPTS")
load("//bazel:unwinder.bzl", "SHARED_UNWINDER_LINKOPTS")

# Exposed to other modules only through the aliases in //:BUILD.bazel.
package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "interface_address",
    srcs = ["interface_address.cpp"],
    hdrs = ["interface_address.h"],
    copts = SAISERVER_COPTS,
    linkopts = ["-pthread"],
    deps = ["@saiserver_sai//:headers"],
)

cc_library(
    name = "tui_rpc",
    srcs = ["tui_rpc.cpp"],
    hdrs = ["tui_rpc.h"],
    copts = SAISERVER_COPTS,
    linkopts = ["-pthread"],
    deps = [
        ":interface_address",
        "//idl:switch_sai_cc",
        "@saiserver_sai//:headers",
    ],
)

cc_library(
    name = "bounded_rpc_processor",
    hdrs = ["bounded_rpc_processor.h"],
    deps = [
        ":tui_rpc",
        "//idl:switch_sai_cc",
    ],
)

# Listener entry points, split from server_lib so the startup regression can
# link the real main against a fake listener.
cc_library(
    name = "rpc_listener_api",
    hdrs = ["switch_sai_rpc_server.h"],
)

cc_library(
    name = "server_lib",
    srcs = ["switch_sai_rpc_server.cpp"],
    hdrs = ["switch_sai_rpc_handler.h"],
    # The legacy handler predates override annotations; retain other warnings.
    # Its parsers throw on unsupported attributes: a throw that can only reach
    # a noexcept boundary would terminate the server instead.
    copts = SAISERVER_COPTS + [
        "-Wno-inconsistent-missing-override",
        "-Werror=exceptions",
    ],
    deps = [
        ":bounded_rpc_processor",
        ":rpc_listener_api",
        ":tui_rpc",
    ],
)

# The implementation is chosen explicitly at deployment, never via host -lsai.
cc_library(
    name = "sai_dynamic",
    srcs = ["sai_dynamic.cpp"],
    copts = SAISERVER_COPTS,
    # A GCC-built SDK must share our unwinder, or its C++ exceptions crash
    # instead of reaching the loader's catch-all: see bazel/unwinder.bzl.
    linkopts = [
        "-ldl",
        "-pthread",
    ] + SHARED_UNWINDER_LINKOPTS,
    target_compatible_with = LINUX,
    deps = ["@saiserver_sai//:headers"],
)

cc_library(
    name = "notifications",
    srcs = ["notifications.cpp"],
    hdrs = ["notifications.h"],
    copts = SAISERVER_COPTS,
    deps = ["@saiserver_sai//:headers"],
)

# The server's main(), without the listener or SDK it links against. The
# binary below supplies the real ones; the startup regression supplies fakes.
cc_library(
    name = "server_main",
    srcs = ["saiserver.cpp"],
    copts = SAISERVER_COPTS,
    linkopts = ["-pthread"],
    deps = [
        ":notifications",
        ":rpc_listener_api",
        ":tui_rpc",
        "@saiserver_sai//:headers",
    ],
)

cc_binary(
    name = "saiserver",
    target_compatible_with = LINUX,
    deps = [
        ":sai_dynamic",
        ":server_lib",
        ":server_main",
    ],
)
