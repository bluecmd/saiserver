load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@saiserver//bazel:thrift.bzl", "cc_thrift_library", "thrift_library")

cc_test(
    name = "cpp_consumer_test",
    srcs = ["consumer.cpp"],
    deps = [
        "@saiserver//:sai_headers",
        "@saiserver//:sai_loader",
        "@saiserver//:server_lib",
        "@saiserver//:thrift_cpp",
        ":consumer_cpp",
    ],
)

rust_test(
    name = "rust_consumer_test",
    srcs = ["consumer.rs"],
    edition = "2021",
    deps = [
        "@saiserver//:client_lib",
        "@saiserver//:thrift_rust",
        "@saiserver//:thrift_rust_runtime",
    ],
)

# Exercise the exported rules and IDL include search from a different
# repository, rather than merely depending on filegroups.
thrift_library(
    name = "consumer_thrift",
    src = "consumer.thrift",
    deps = ["@saiserver//:thrift_idl"],
)

cc_thrift_library(
    name = "consumer_cpp",
    lib = ":consumer_thrift",
    outs = [
        "consumer_types.cpp",
        "consumer_types.h",
    ],
    deps = ["@saiserver//:thrift_cpp"],
)

filegroup(
    name = "all_exports",
    srcs = [
        ":consumer_thrift",
        "@saiserver//:thrift_idl",
        "@saiserver//:client",
        "@saiserver//:server",
    ],
)
