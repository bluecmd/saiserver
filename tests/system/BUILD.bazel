# System tests: the real saiserver and sai-tui against SONiC's virtual-switch
# SAI (libsaivs), in a pinned Debian rootfs inside unprivileged namespaces.
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rustfmt_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@tar.bzl", "tar")
load("//bazel:constraints.bzl", "LINUX_X86_64")
load("//bazel:copts.bzl", "SAISERVER_TEST_COPTS")

cc_binary(
    name = "nsrun",
    testonly = True,
    srcs = ["nsrun.cc"],
    copts = SAISERVER_TEST_COPTS,
    target_compatible_with = LINUX_X86_64,
)

# Debian maintainer scripts normally create /bin/sh; they are not run here.
# libsaivs shells out (`ip macsec show`) while creating the switch.
tar(
    name = "sh_link",
    mtree = ["./usr/bin/sh type=link link=bash"],
)

flatten(
    name = "vs_rootfs",
    testonly = True,
    target_compatible_with = LINUX_X86_64,
    tars = [
        "@systest_trixie//:flat",
        "@sonic_vs_libsaimetadata//:data",
        "@sonic_vs_libsaivs//:data",
        "@sonic_vs_libswsscommon//:data",
        ":sh_link",
    ],
)

cc_binary(
    name = "fdb_learning",
    testonly = True,
    srcs = ["fdb_learning.cc"],
    copts = SAISERVER_TEST_COPTS,
    target_compatible_with = LINUX_X86_64,
    deps = [
        "//idl:switch_sai_cc",
        "@saiserver_sai//:headers",
    ],
)

rust_binary(
    name = "docs_workflows",
    testonly = True,
    srcs = ["docs_workflows.rs"],
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    deps = ["@saiserver_crates//:serde_json"],
)

rustfmt_test(
    name = "rustfmt_test",
    size = "small",
    targets = [":docs_workflows"],
)

_VS = [
    ":nsrun",
    ":vs_rootfs",
    "//src:saiserver",
    "//tui:sai-tui",
    "vs_switch.sh",
    "vs.profile",
    "database_config.json",
]

_VS_ARGS = ["$(rlocationpath %s)" % label for label in _VS]

# Every command in docs/tui.md's "Explicit workflows" must work verbatim.
sh_test(
    name = "vs_docs_workflows_test",
    size = "medium",
    srcs = ["vs_test.sh"],
    args = _VS_ARGS + [
        "--bind",
        "$(rlocationpath :docs_workflows):/systest/bin/docs_workflows",
        "--bind",
        "$(rlocationpath //docs:tui.md):/systest/docs/tui.md",
        "--",
        "/systest/bin/docs_workflows",
        # libsaivs cannot read back ACL table match-field enables that were not
        # set at creation (create-only attributes, so readback stays strict).
        "--known-unsupported",
        # (Bazel tokenizes args like a shell, hence the inner quotes.)
        "'IPv4/IPv6 ACLs and binding=attr 4096'",
        "/systest/bin/sai-tui",
        "/systest/docs/tui.md",
    ],
    data = _VS + [
        ":docs_workflows",
        "//docs:tui.md",
    ],
    # Needs unprivileged user namespaces (and /dev/net/tun) on the test host.
    tags = ["no-remote-exec"],
    target_compatible_with = LINUX_X86_64,
    deps = ["@rules_shell//shell/runfiles"],
)

_VS_FDB = [label if label != "vs.profile" else "vs_fdb.profile" for label in _VS]

# Frames on a port's veth are learned, moved and flushed via SAI notifications.
# Needs /dev/net/tun: libsaivs only learns on ports with TAP host interfaces.
sh_test(
    name = "vs_fdb_learning_test",
    size = "medium",
    srcs = ["vs_test.sh"],
    args = ["$(rlocationpath %s)" % label for label in _VS_FDB] + [
        "--bind",
        "$(rlocationpath :fdb_learning):/systest/bin/fdb_learning",
        "--bind",
        "$(rlocationpath :lanemap.ini):/systest/lanemap.ini",
        "--",
        "--veth",
        "eth1",
        "--veth",
        "eth2",
        "/systest/bin/fdb_learning",
    ],
    data = _VS_FDB + [
        "lanemap.ini",
        ":fdb_learning",
    ],
    # Needs unprivileged user namespaces (and /dev/net/tun) on the test host.
    tags = ["no-remote-exec"],
    target_compatible_with = LINUX_X86_64,
    deps = ["@rules_shell//shell/runfiles"],
)

# A C++ exception thrown by a GCC-built SDK must not crash the server.
sh_test(
    name = "vs_sdk_exception_test",
    size = "small",
    srcs = ["vs_test.sh"],
    args = _VS_ARGS + [
        "--bind",
        "$(rlocationpath :sdk_exception.sh):/systest/sdk_exception.sh",
        "--",
        "--no-server",
        "/bin/bash",
        "/systest/sdk_exception.sh",
    ],
    data = _VS + ["sdk_exception.sh"],
    # Needs unprivileged user namespaces (and /dev/net/tun) on the test host.
    tags = ["no-remote-exec"],
    target_compatible_with = LINUX_X86_64,
    deps = ["@rules_shell//shell/runfiles"],
)
