load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:copts.bzl", "SAISERVER_TEST_COPTS")

cc_test(
    name = "server_test",
    size = "small",
    srcs = ["server/tui_rpc_test.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = ["//src:tui_rpc"],
)

cc_library(
    name = "fake_sdk",
    testonly = True,
    srcs = ["server/fake_sdk.cpp"],
    hdrs = ["server/fake_sdk.h"],
    copts = SAISERVER_TEST_COPTS,
    deps = ["//src:interface_address"],
)

cc_test(
    name = "interface_address_test",
    size = "small",
    srcs = ["server/interface_address_test.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = [":fake_sdk"],
)

cc_test(
    name = "interface_address_rpc_test",
    size = "small",
    srcs = ["server/interface_address_rpc_test.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = [
        ":fake_sdk",
        "//src:bounded_rpc_processor",
        "//src:tui_rpc",
    ],
)

# The legacy hostif RPCs, through the real handler and processor.
cc_test(
    name = "hostif_rpc_test",
    size = "small",
    srcs = ["server/hostif_rpc_test.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = [
        ":fake_sdk",
        "//src:bounded_rpc_processor",
        "//src:notifications",
        "//src:server_lib",
    ],
)

# Real server main linked against the fixture's fake SDK and RPC listener.
cc_binary(
    name = "startup_test_bin",
    testonly = True,
    srcs = ["server/startup_test.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = [
        ":fake_sdk",
        "//src:notifications",
        "//src:rpc_listener_api",
        "//src:server_main",
        "//src:tui_rpc",
    ],
)

sh_test(
    name = "startup_test",
    size = "small",
    srcs = ["server/startup_cases.sh"],
    args = ["$(rlocationpath :startup_test_bin)"],
    data = [":startup_test_bin"],
    deps = ["@rules_shell//shell/runfiles"],
)

cc_test(
    name = "fdb_events_test",
    size = "small",
    srcs = ["test_fdb_events.cpp"],
    copts = SAISERVER_TEST_COPTS,
    deps = ["//src:notifications"],
)

cc_binary(
    name = "fake_sai.so",
    testonly = True,
    srcs = ["fake_sai.cpp"],
    copts = SAISERVER_TEST_COPTS,
    linkshared = True,
    deps = ["//:sai_headers"],
)

cc_binary(
    name = "incomplete_fake_sai.so",
    testonly = True,
    srcs = ["fake_sai.cpp"],
    copts = SAISERVER_TEST_COPTS,
    linkshared = True,
    local_defines = ["FAKE_SAI_OMIT_LOG_SET"],
    deps = ["//:sai_headers"],
)

cc_binary(
    name = "optional_fake_sai.so",
    testonly = True,
    srcs = [
        "fake_sai.cpp",
        "server/fake_optional_sai.cpp",
    ],
    copts = SAISERVER_TEST_COPTS,
    linkshared = True,
    deps = ["//:sai_headers"],
)

cc_test(
    name = "sai_dynamic_test",
    size = "small",
    srcs = ["test_sai_dynamic.cpp"],
    args = [
        "$(rlocationpath :fake_sai.so)",
        "$(rlocationpath :incomplete_fake_sai.so)",
        "$(rlocationpath :optional_fake_sai.so)",
    ],
    copts = SAISERVER_TEST_COPTS,
    data = [
        ":fake_sai.so",
        ":incomplete_fake_sai.so",
        ":optional_fake_sai.so",
    ],
    deps = [
        "//src:sai_dynamic",
        "@rules_cc//cc/runfiles",
    ],
)

sh_test(
    name = "bazelw_test",
    size = "small",
    srcs = ["test_bazelw.sh"],
    args = ["$(rlocationpath //:bazelw)"],
    data = ["//:bazelw"],
    deps = ["@rules_shell//shell/runfiles"],
)

# Every non-manual test in this package.
test_suite(name = "tests")
