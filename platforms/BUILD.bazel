# Execution platforms. See docs/bazel.md ("Remote execution").

# BuildBuddy's Linux x86-64 executors run each action in its own OCI
# container. Pinning that container makes the execution userspace (the bash
# and coreutils used by Bazel's test harness and rules_rust's bootstrap; all
# compilers are downloaded toolchains) the same everywhere: the official Debian
# bookworm image, by digest.
platform(
    name = "remote_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://docker.io/library/debian@sha256:f9c4778ec75d6b054367315b1eb4f3992ee5866b50de6d591a33e8904cba3f17",
        # Like local sandboxed actions: no network inside build and test actions.
        "dockerNetwork": "off",
    },
    visibility = ["//visibility:public"],
)
