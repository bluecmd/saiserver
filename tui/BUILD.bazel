load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rustfmt_test")
load("//bazel:constraints.bzl", "LINUX_X86_64")

# Exposed to other modules only through the aliases in //:BUILD.bazel.
package(default_visibility = ["//:__subpackages__"])

# The client re-exports the generated //idl:sai_tui_rust crate as `sai_tui::sai_tui`.
rust_library(
    name = "sai_tui",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = ["//docs/evidence/seastone2:ixp-lab-sw2-sanitized.json"],
    crate_name = "sai_tui",
    crate_root = "src/lib.rs",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    version = "0.1.0",
    deps = [
        "//idl:sai_tui_rust",
        "@saiserver_crates//:crossterm",
        "@saiserver_crates//:ratatui",
        "@saiserver_crates//:serde",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:shell-words",
        "@saiserver_crates//:signal-hook",
        "@saiserver_crates//:thrift",
    ],
)

rust_binary(
    name = "sai-tui",
    srcs = ["src/main.rs"],
    crate_name = "sai_tui_bin",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    version = "0.1.0",
    deps = [
        ":sai_tui",
        "@saiserver_crates//:clap",
        "@saiserver_crates//:serde_json",
    ],
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":sai_tui",
    target_compatible_with = LINUX_X86_64,
)

rust_test(
    name = "cli_test",
    size = "small",
    srcs = ["tests/cli.rs"],
    crate_name = "cli_test",
    data = [":sai-tui"],
    edition = "2021",
    # Resolved with the runfiles library, so it also works from other modules.
    rustc_env = {"SAI_TUI_RLOCATIONPATH": "$(rlocationpath :sai-tui)"},
    target_compatible_with = LINUX_X86_64,
    deps = [
        ":sai_tui",
        "@rules_rust//rust/runfiles",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:thrift",
    ],
)

rust_test(
    name = "safety_test",
    size = "small",
    srcs = ["tests/safety.rs"],
    crate_name = "safety_test",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    deps = [":sai_tui"],
)

rust_test(
    name = "config_apply_test",
    size = "small",
    srcs = ["tests/config_apply.rs"],
    crate_name = "config_apply_test",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    deps = [":sai_tui"],
)

rustfmt_test(
    name = "rustfmt_test",
    size = "small",
    targets = [
        ":cli_test",
        ":config_apply_test",
        ":safety_test",
        ":sai-tui",
        ":sai_tui",
    ],
)

# Every non-manual test in this package.
test_suite(name = "tests")
