load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Repository-relative labels allow this package to be used through Bzlmod.
# Only Linux x86_64 is currently supported by the parent toolchain setup.
_LINUX_X86_64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# Keep the existing client on its checked-in bindings. The separately generated
# RPC crate below is deliberately independent of the TUI and client modules.
rust_library(
    name = "sai_tui",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "sai_tui",
    crate_root = "src/lib.rs",
    compile_data = ["//docs/evidence/seastone2:ixp-lab-sw2-sanitized.json"],
    edition = "2021",
    target_compatible_with = _LINUX_X86_64,
    version = "0.1.0",
    deps = [
        "@saiserver_crates//:crossterm",
        "@saiserver_crates//:ratatui",
        "@saiserver_crates//:serde",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:shell-words",
        "@saiserver_crates//:signal-hook",
        "@saiserver_crates//:thrift",
    ],
)

rust_binary(
    name = "sai-tui",
    srcs = ["src/main.rs"],
    crate_name = "sai_tui_bin",
    edition = "2021",
    target_compatible_with = _LINUX_X86_64,
    version = "0.1.0",
    deps = [
        ":sai_tui",
        "@saiserver_crates//:clap",
        "@saiserver_crates//:serde_json",
    ],
)

# The parent provides a single .rs output, generated by a declared Thrift tool.
# Using that output as the crate root avoids a wrapper or host code generation.
rust_library(
    name = "sai_tui_rpc",
    srcs = ["//src:sai_tui_rs"],
    crate_name = "sai_tui_rpc",
    crate_root = "//src:sai_tui_rs",
    edition = "2021",
    target_compatible_with = _LINUX_X86_64,
    version = "0.1.0",
    deps = ["@saiserver_crates//:thrift"],
)

rust_test(
    name = "unit_tests",
    crate = ":sai_tui",
    target_compatible_with = _LINUX_X86_64,
)

rust_test(
    name = "cli_test",
    size = "small",
    srcs = ["tests/cli.rs"],
    crate_name = "cli_test",
    edition = "2021",
    # env! embeds a runfiles-relative path, not an execroot/host absolute path.
    # Bazel tests start in the main repository's runfiles directory; rootpath
    # also handles ../<repo>/... when this package is an external dependency.
    data = [":sai-tui"],
    rustc_env = {"CARGO_BIN_EXE_sai-tui": "$(rootpath :sai-tui)"},
    target_compatible_with = _LINUX_X86_64,
    deps = [
        ":sai_tui",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:thrift",
    ],
)

rust_test(
    name = "safety_test",
    size = "small",
    srcs = ["tests/safety.rs"],
    crate_name = "safety_test",
    edition = "2021",
    target_compatible_with = _LINUX_X86_64,
    deps = [":sai_tui"],
)

rust_test(
    name = "config_apply_test",
    size = "small",
    srcs = ["tests/config_apply.rs"],
    crate_name = "config_apply_test",
    edition = "2021",
    target_compatible_with = _LINUX_X86_64,
    deps = [":sai_tui"],
)

test_suite(
    name = "tests",
    tests = [
        ":cli_test",
        ":config_apply_test",
        ":safety_test",
        ":unit_tests",
    ],
)
