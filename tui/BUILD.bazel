load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel:constraints.bzl", "LINUX_X86_64")

# Exposed to other modules only through the aliases in //:BUILD.bazel.
package(default_visibility = ["//:__subpackages__"])

exports_files([
    "Cargo.Bazel.lock",
    "Cargo.lock",
    "Cargo.toml",
])

# Cargo builds need the RPC module checked in. Its test fails if it drifts from
# the pinned compiler's output; `bazel run //tui:update_bindings` rewrites it.
write_source_files(
    name = "update_bindings",
    files = {"src/sai_tui.rs": "//idl:sai_tui_rust_codegen"},
)

# The client uses the checked-in module. The separately generated RPC crate,
# //idl:sai_tui_rust, is deliberately independent of it.
rust_library(
    name = "sai_tui",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "sai_tui",
    crate_root = "src/lib.rs",
    compile_data = ["//docs/evidence/seastone2:ixp-lab-sw2-sanitized.json"],
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    version = "0.1.0",
    deps = [
        "@saiserver_crates//:crossterm",
        "@saiserver_crates//:ratatui",
        "@saiserver_crates//:serde",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:shell-words",
        "@saiserver_crates//:signal-hook",
        "@saiserver_crates//:thrift",
    ],
)

rust_binary(
    name = "sai-tui",
    srcs = ["src/main.rs"],
    crate_name = "sai_tui_bin",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    version = "0.1.0",
    deps = [
        ":sai_tui",
        "@saiserver_crates//:clap",
        "@saiserver_crates//:serde_json",
    ],
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":sai_tui",
    target_compatible_with = LINUX_X86_64,
)

rust_test(
    name = "cli_test",
    size = "small",
    srcs = ["tests/cli.rs"],
    crate_name = "cli_test",
    edition = "2021",
    # env! embeds a runfiles-relative path, not an execroot/host absolute path.
    # Bazel tests start in the main repository's runfiles directory; rootpath
    # also handles ../<repo>/... when this package is an external dependency.
    data = [":sai-tui"],
    rustc_env = {"CARGO_BIN_EXE_sai-tui": "$(rootpath :sai-tui)"},
    target_compatible_with = LINUX_X86_64,
    deps = [
        ":sai_tui",
        "@saiserver_crates//:serde_json",
        "@saiserver_crates//:thrift",
    ],
)

rust_test(
    name = "safety_test",
    size = "small",
    srcs = ["tests/safety.rs"],
    crate_name = "safety_test",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    deps = [":sai_tui"],
)

rust_test(
    name = "config_apply_test",
    size = "small",
    srcs = ["tests/config_apply.rs"],
    crate_name = "config_apply_test",
    edition = "2021",
    target_compatible_with = LINUX_X86_64,
    deps = [":sai_tui"],
)

# Every non-manual test in this package.
test_suite(name = "tests")
